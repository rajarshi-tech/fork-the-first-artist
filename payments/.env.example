# ── payments service ──────────────────────────────────────────────
# Copy to .env. NEVER commit .env (it holds keys).

# dev  = mock facilitator + mock settlement + local spend log (no keys needed)
# live = real x402 on Hedera testnet (needs the accounts below)
PAYMENTS_MODE=dev
PORT=8402

# ── Hedera (live mode only) ───────────────────────────────────────
HEDERA_NETWORK=hedera:testnet
FACILITATOR_URL=https://x402.org/facilitator
# testnet USDC (authoritative, from @x402/hedera DEFAULT_ASSETS)
HEDERA_ASSET=0.0.429274
HEDERA_ASSET_DECIMALS=6

# artist payout account (from the ENS text record) — funds go HERE
HEDERA_ARTIST_ACCOUNT_ID=
# agent compute account — receives the 3.69% share, pays the inference meter
HEDERA_COMPUTE_ACCOUNT_ID=
# key of the compute account (used by the demo payer / facilitator-less settle)
HEDERA_AGENT_PRIVATE_KEY=

# HCS topics (create in the Hedera portal)
HCS_SPEND_TOPIC_ID=
HCS_CLAIM_TOPIC_ID=

# treasury — only used by scripts/create-tip-token.ts (the 3.69% custom fee)
HEDERA_TREASURY_ACCOUNT_ID=
HEDERA_TREASURY_PRIVATE_KEY=

# ── split (basis points, must total 10000) ────────────────────────
SPLIT_ARTIST_BPS=9631
SPLIT_AGENT_BPS=369

# ── prices (USDC, 6 decimals) ─────────────────────────────────────
PRICE_ASK_USDC=0.10            # fan → artist steward, per question
PRICE_METER_USDC=0.002         # steward → meter, per inference call

# ── budgets enforced at the meter (before payment is quoted) ──────
BUDGET_TOTAL_USD=5
BUDGET_HOURLY_USD=0.05
BUDGET_MAX_PER_CALL_USD=0.01

# ── upstream inference (the thing the meter resells) ──────────────
UPSTREAM_BASE_URL=https://router-api.0g.ai/v1
UPSTREAM_API_KEY=
UPSTREAM_MODEL=0gm-1.0-35b-a3b
UPSTREAM_TRUST_MODE=verified

# ── who the meter resells to / logs about ─────────────────────────
STEWARD_URL=http://localhost:8403
